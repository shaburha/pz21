<%- include('partials/header') %>

<div class="page-head">
  <h1>Документы</h1>
  <a class="btn" href="/add<%= authQuery %>">+ Новый документ</a>
</div>

<% if (user.isGuest) { %>
  <p class="notice">Вы вошли как гость: просмотр доступен, создание документов — только после входа.</p>
<% } %>

<form class="filter" method="get" action="/">
  <% if (authQuery) { %><input type="hidden" name="auth" value="1"><% } %>
  <label for="status">Статус:</label>
  <select id="status" name="status">
    <option value="">Все (<%= total %>)</option>
    <% Object.entries(statuses).forEach(([key, label]) => { %>
      <option value="<%= key %>" <%= key === currentStatus ? 'selected' : '' %>><%= label %></option>
    <% }) %>
  </select>
  <button class="btn btn-small btn-ghost" type="submit">Показать</button>
</form>

<% if (documents.length === 0) { %>
  <p class="empty">Документов с таким статусом нет.</p>
<% } else { %>
  <table class="table">
    <thead>
      <tr>
        <th>#</th>
        <th>Название</th>
        <th>Статус</th>
        <th>Владелец</th>
        <th>Участники</th>
        <th>Изменён</th>
      </tr>
    </thead>
    <tbody>
      <% documents.forEach((doc) => { %>
        <tr>
          <td><%= doc.id %></td>
          <td><a href="/item/<%= doc.id %><%= authQuery %>"><%= doc.title %></a></td>
          <td><%- include('partials/status-badge', { status: doc.status }) %></td>
          <td><%= doc.owner %></td>
          <td><%= doc.collaborators.length %></td>
          <td><%= formatDate(doc.updatedAt) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
